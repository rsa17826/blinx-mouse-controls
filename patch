#!/usr/bin/env bash
PITCH=0x00141fb5
YAW=0x00141fb9
(
  echo './_patch/disable_autoaim.py' &&
    ./_patch/disable_autoaim.py &&
    echo './_patch/install_zero_stick_angle.py 0x1d7c00' &&
    ./_patch/install_zero_stick_angle.py 0x1d7c00 &&
    echo './_patch/fix_wrong_walk_dir.py 0x1d7b00' &&
    ./_patch/fix_wrong_walk_dir.py 0x1d7b00 &&
    echo './_patch/install_asia_mouselook.py 0x00141ee5' &&
    ./_patch/install_asia_mouselook.py 0x00141ee5 &&
    echo './_patch/install_heading_readers.py 0x1d7d32 0x00141fcd' &&
    ./_patch/install_heading_readers.py 0x1d7d32 0x00141fcd &&
    # don't change shot direction while ff active
    echo './_patch/install_shot_direction.py 0x1d7e32 $PITCH $YAW 1' &&
    ./_patch/install_shot_direction.py 0x1d7e32 $PITCH $YAW 1 &&
    echo './_patch/install_asia_position.py 0x001d797c $YAW -18 '-25 &&
    ./_patch/install_asia_position.py 0x001d797c $YAW -18 -25
) || (
  echo "FAILED!"
  exit 1
)
