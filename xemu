#!/usr/bin/env sh

if test -f xemu.toml; then
  cp xemu.toml "$HOME/.local/share/xemu/xemu/xemu.toml"
fi
while :; do
  pkill -9 xemu
  sleep .01
  xemu -s -qmp tcp:localhost:4444,server,nowait &
  # LD_LIBRARY_PATH=/run/opengl-driver/lib mangohud xemu -s -qmp tcp:localhost:4444,server,nowait &

  read _
done
